# pantalla.py  -  Responsable: Sebastián
# La pantalla del juego: un Canvas que dibuja lo que la lógica le dice.
# No calcula choques ni puntajes: eso lo hace Juego (logica.py).
import random
import tkinter as tk
from logica import Juego, Jefe, ANCHO, ALTO

FONDO = "#05060f"
CIAN = "#38e8ff"
MAGENTA = "#ff3fd8"
NARANJA = "#ffa63a"
ROJO = "#ff4b5c"
AMARILLO = "#ffe45c"
BLANCO = "#e8f1ff"
GRIS = "#5b6b8c"

COLOR_ENEMIGO = {"basico": MAGENTA, "zigzag": NARANJA, "jefe": ROJO, "nave": CIAN}


class PantallaJuego(tk.Canvas):
    # Hereda de Canvas: la clase ES el lienzo donde se dibuja el juego.
    def __init__(self, padre, nombre, al_terminar):
        super().__init__(padre, width=ANCHO, height=ALTO, bg=FONDO, highlightthickness=0)
        self.juego = Juego()                # la lógica, en un solo atributo
        self.nombre = nombre                # dato de ida (llega por el constructor)
        self.al_terminar = al_terminar      # callback: a quién avisar al perder
        self.raiz = padre
        self.teclas = set()
        self.pausado = False
        self.cuadros_final = 0
        self.cuadro = 0           # contador de cuadros dibujados
        self.temblor = 0
        self.particulas = []
        self.estrellas = [[random.randint(0, ANCHO), random.randint(0, ALTO),
                           random.choice([1, 2, 3])] for _ in range(90)]
        self.raiz.bind("<KeyPress>", self.tecla_abajo)
        self.raiz.bind("<KeyRelease>", self.tecla_arriba)
        self.focus_set()
        self.bucle()

    # ---------- teclado (eventos y callbacks, clase 10) ----------
    def tecla_abajo(self, evento):
        tecla = evento.keysym.lower()
        if tecla == "escape":
            self.pausado = not self.pausado
        self.teclas.add(tecla)

    def tecla_arriba(self, evento):
        self.teclas.discard(evento.keysym.lower())

    # ---------- el ciclo del juego ----------
    def bucle(self):
        self.cuadro += 1
        if not self.pausado:
            izquierda = "left" in self.teclas or "a" in self.teclas
            derecha = "right" in self.teclas or "d" in self.teclas
            disparando = "space" in self.teclas
            self.juego.avanzar(izquierda, derecha, disparando)
            self.leer_eventos()
            self.mover_particulas()
        self.dibujar()

        if self.juego.terminado:
            self.cuadros_final += 1
            if self.cuadros_final > 70:     # deja ver la explosión antes de cerrar
                self.terminar()
                return
        self.after(16, self.bucle)          # vuelve a llamarse en 16 ms (unos 60 cuadros por segundo)

    def terminar(self):
        self.raiz.unbind("<KeyPress>")
        self.raiz.unbind("<KeyRelease>")
        self.al_terminar(self.nombre, self.juego.puntaje)   # VUELTA por callback

    # ---------- efectos (solo visuales) ----------
    def leer_eventos(self):
        for tipo, x, y, quien in self.juego.eventos:
            color = COLOR_ENEMIGO.get(quien, BLANCO)
            if tipo == "explosion":
                cantidad = 60 if quien in ("jefe", "nave") else 22
                self.explotar(x, y, color, cantidad)
                self.temblor = 14 if quien in ("jefe", "nave") else 4
            elif tipo == "impacto":
                self.explotar(x, y, AMARILLO, 5)
            elif tipo == "golpe":
                self.explotar(x, y, CIAN, 18)
                self.temblor = 10

    def explotar(self, x, y, color, cantidad):
        for _ in range(cantidad):
            self.particulas.append([x, y, random.uniform(-5, 5), random.uniform(-5, 5),
                                    random.randint(18, 38), color])

    def mover_particulas(self):
        for p in self.particulas:
            p[0] += p[2]
            p[1] += p[3]
            p[2] *= 0.94
            p[3] *= 0.94
            p[4] -= 1
        self.particulas = [p for p in self.particulas if p[4] > 0]
        for estrella in self.estrellas:
            estrella[1] += estrella[2]      # las estrellas lejanas van más lento (paralaje)
            if estrella[1] > ALTO:
                estrella[0] = random.randint(0, ANCHO)
                estrella[1] = 0

    # ---------- dibujo ----------
    def dibujar(self):
        self.delete("all")
        for x, y, capa in self.estrellas:
            color = {1: "#2a3352", 2: "#56658f", 3: "#b9c6ff"}[capa]
            self.create_rectangle(x, y, x + capa - 1, y + capa * 2, fill=color, outline="")

        for bala in self.juego.balas:
            color = ROJO if bala.enemiga else AMARILLO
            self.create_rectangle(bala.x - 2, bala.y - 7, bala.x + 2, bala.y + 7,
                                  fill=color, outline="")

        for enemigo in self.juego.enemigos:
            self.dibujar_enemigo(enemigo)

        nave = self.juego.nave
        parpadeo = nave.invulnerable and (self.cuadro // 4) % 2 == 0
        if nave.vida > 0 and not parpadeo:
            self.dibujar_nave(nave.x, nave.y)

        for x, y, _, _, vida, color in self.particulas:
            r = max(1, vida / 10)
            self.create_oval(x - r, y - r, x + r, y + r, fill=color, outline="")

        self.dibujar_hud()

        if self.temblor > 0:                # sacudida de pantalla
            self.move("all", random.randint(-self.temblor, self.temblor),
                      random.randint(-self.temblor, self.temblor))
            self.temblor -= 1

        if self.pausado:
            self.create_text(ANCHO // 2, ALTO // 2, text="PAUSA", fill=CIAN,
                             font=("Consolas", 40, "bold"))
            self.create_text(ANCHO // 2, ALTO // 2 + 40, text="Esc para seguir",
                             fill=GRIS, font=("Consolas", 12))

    def dibujar_nave(self, x, y):
        llama = random.randint(8, 16)
        self.create_polygon(x - 7, y + 16, x, y + 16 + llama, x + 7, y + 16,
                            fill=NARANJA, outline="")
        self.create_polygon(x, y - 22, x + 18, y + 16, x + 6, y + 10, x - 6, y + 10,
                            x - 18, y + 16, fill="#0b2a3a", outline=CIAN, width=2)
        self.create_oval(x - 4, y - 6, x + 4, y + 4, fill=CIAN, outline="")
    

    def dibujar_enemigo(self, e):
        color = COLOR_ENEMIGO[e.TIPO]
        x, y = e.x, e.y
        if e.TIPO == "basico":
            self.create_polygon(x - 17, y - 12, x + 17, y - 12, x + 8, y + 4,
                                x, y + 15, x - 8, y + 4, fill="#2a0a2a",
                                outline=color, width=2)
        elif e.TIPO == "zigzag":
            self.create_polygon(x, y - 15, x + 17, y, x, y + 15, x - 17, y,
                                fill="#2a1700", outline=color, width=2)
        else:                               # jefe
            self.create_polygon(x - 60, y - 20, x + 60, y - 20, x + 45, y + 15,
                                x + 15, y + 32, x - 15, y + 32, x - 45, y + 15,
                                fill="#2a0508", outline=color, width=3)
            self.create_oval(x - 10, y - 8, x + 10, y + 12, fill=color, outline="")
            ancho = 110 * e.vida / Jefe.VIDA_MAXIMA
            self.create_rectangle(x - 55, y - 34, x + 55, y - 28, outline=GRIS)
            self.create_rectangle(x - 55, y - 34, x - 55 + ancho, y - 28, fill=color, outline="")
        self.create_oval(x - 3, y - 3, x + 3, y + 3, fill=BLANCO, outline="")

    def dibujar_hud(self):
        self.create_text(16, 16, anchor="nw", text=f"PUNTAJE  {self.juego.puntaje:06d}",
                         fill=BLANCO, font=("Consolas", 14, "bold"))
        self.create_text(16, 40, anchor="nw", text=f"SECTOR {self.juego.nivel}",
                         fill=CIAN, font=("Consolas", 11))
        self.create_text(ANCHO - 16, 16, anchor="ne", text=self.nombre.upper(),
                         fill=GRIS, font=("Consolas", 11))
        for i in range(self.juego.nave.vida):
            x = ANCHO - 26 - i * 26
            self.create_polygon(x, 36, x + 9, 52, x - 9, 52, fill=CIAN, outline="")

# ventanas.py  -  Responsable: Karen
# Las ventanas del juego: menú, nombre del piloto, game over y puntajes.
# Aplica la clase 11: Toplevel, ventanas modales, datos de ida y callback de vuelta.
import random
import tkinter as tk
from tkinter import ttk, messagebox
from logica import ANCHO, ALTO
from pantalla import PantallaJuego

FONDO = "#05060f"
PANEL = "#14204a"
CIAN = "#38e8ff"
MAGENTA = "#ff3fd8"
BLANCO = "#e8f1ff"
GRIS = "#5b6b8c"


def preparar_estilos(raiz):
    estilo = ttk.Style(raiz)
    estilo.theme_use("clam")                # el tema "clam" deja cambiar colores
    estilo.configure("TFrame", background=PANEL)
    estilo.configure("TLabel", background=PANEL, foreground=BLANCO, font=("Consolas", 11))
    estilo.configure("Titulo.TLabel", foreground=CIAN, font=("Consolas", 20, "bold"))
    estilo.configure("TButton", background="#14204a", foreground=BLANCO,
                     font=("Consolas", 12, "bold"), padding=8, borderwidth=0)
    estilo.map("TButton", background=[("active", CIAN)], foreground=[("active", FONDO)])
    estilo.configure("TEntry", fieldbackground=FONDO, foreground=BLANCO, insertcolor=CIAN)
    estilo.configure("Treeview", background=FONDO, fieldbackground=FONDO,
                     foreground=BLANCO, font=("Consolas", 11), rowheight=24)
    estilo.configure("Treeview.Heading", background="#14204a", foreground=CIAN,
                     font=("Consolas", 11, "bold"))


def centrar(ventana, padre):
    # Ubica una ventana secundaria en el centro de la principal.
    ventana.update_idletasks()
    x = padre.winfo_rootx() + (padre.winfo_width() - ventana.winfo_reqwidth()) // 2
    y = padre.winfo_rooty() + (padre.winfo_height() - ventana.winfo_reqheight()) // 3
    ventana.geometry(f"+{x}+{y}")


class DialogoNombre(tk.Toplevel):
    # Ventana secundaria MODAL: pide el nombre y lo devuelve por callback.
    def __init__(self, padre, al_aceptar):
        super().__init__(padre)
        self.title("Piloto")
        self.configure(bg=PANEL)
        self.resizable(False, False)
        self.al_aceptar = al_aceptar        # a quién avisar (callback)
        self.nombre = tk.StringVar()

        marco = ttk.Frame(self, padding=24)
        marco.pack()
        ttk.Label(marco, text="IDENTIFÍQUESE, PILOTO", style="Titulo.TLabel").pack(pady=(0, 12))
        entrada = ttk.Entry(marco, textvariable=self.nombre, font=("Consolas", 14), width=16)
        entrada.pack(pady=6)
        ttk.Button(marco, text="DESPEGAR", command=self.aceptar).pack(pady=(12, 0), fill="x")
        self.bind("<Return>", lambda evento: self.aceptar())

        centrar(self, padre)
        self.transient(padre)               # encima de la principal
        self.grab_set()                     # modal: la principal no responde
        entrada.focus_set()                 # el cursor queda listo para escribir

    def aceptar(self):
        nombre = self.nombre.get().strip()
        if not nombre:
            messagebox.showerror("Dato inválido", "Escriba el nombre del piloto.", parent=self)
            return                          # sigue abierta
        if len(nombre) > 12:
            messagebox.showerror("Dato inválido", "Máximo 12 caracteres.", parent=self)
            return
        self.destroy()                      # primero se cierra (suelta el teclado)...
        self.al_aceptar(nombre)             # ...y luego avisa a la principal


class DialogoPuntajes(tk.Toplevel):
    # Ventana MODAL con la tabla de los mejores puntajes (Treeview, clase 10).
    def __init__(self, padre, puntajes, titulo="MEJORES PILOTOS"):
        super().__init__(padre)
        self.title("Puntajes")
        self.configure(bg=PANEL)
        self.resizable(False, False)
        self.marco = ttk.Frame(self, padding=24)
        self.marco.pack()
        ttk.Label(self.marco, text=titulo, style="Titulo.TLabel").pack(pady=(0, 12))

        tabla = ttk.Treeview(self.marco, columns=("pos", "piloto", "puntos"),
                             show="headings", height=5)
        for columna, texto, ancho in (("pos", "#", 40), ("piloto", "PILOTO", 150),
                                      ("puntos", "PUNTOS", 100)):
            tabla.heading(columna, text=texto)
            tabla.column(columna, width=ancho, anchor="center")
        for i, (nombre, puntos) in enumerate(puntajes, start=1):
            tabla.insert("", "end", values=(i, nombre, puntos))
        tabla.pack()
        if not puntajes:
            ttk.Label(self.marco, text="Aún no hay partidas.").pack(pady=8)

        self.botones = ttk.Frame(self.marco)
        self.botones.pack(pady=(14, 0), fill="x")
        self.agregar_botones()

        centrar(self, padre)
        self.transient(padre)
        self.grab_set()

    def agregar_botones(self):
        ttk.Button(self.botones, text="CERRAR", command=self.destroy).pack(fill="x")


class DialogoFinal(DialogoPuntajes):
    # HERENCIA: es la misma tabla de puntajes, pero con el puntaje de la
    # partida y otros botones. SOBRESCRIBE agregar_botones().
    def __init__(self, padre, nombre, puntaje, puntajes, al_elegir):
        self.al_elegir = al_elegir          # callback: "otra" o "menu"
        super().__init__(padre, puntajes, titulo="GAME OVER")
        ttk.Label(self.marco, text=f"{nombre}: {puntaje} puntos",
                  foreground=MAGENTA, font=("Consolas", 14, "bold")).pack(before=self.botones, pady=(10, 0))
        self.protocol("WM_DELETE_WINDOW", lambda: self.elegir("menu"))

    def agregar_botones(self):
        ttk.Button(self.botones, text="JUGAR OTRA VEZ",
                   command=lambda: self.elegir("otra")).pack(fill="x", pady=(0, 6))
        ttk.Button(self.botones, text="MENÚ", command=lambda: self.elegir("menu")).pack(fill="x")

    def elegir(self, opcion):
        self.destroy()
        self.al_elegir(opcion)


class VentanaPrincipal(tk.Tk):
    # La ventana raíz: una sola por programa. Las demás son Toplevel.
    def __init__(self):
        super().__init__()
        self.title("SECTOR ZERO")
        self.configure(bg=FONDO)
        self.resizable(False, False)
        preparar_estilos(self)
        self.puntajes = []                  # lista de (nombre, puntos)
        self.ultimo_piloto = ""
        self.mostrar_menu()

    def limpiar(self):
        for widget in self.winfo_children():
            widget.destroy()

    def mostrar_menu(self):
        self.limpiar()
        lienzo = tk.Canvas(self, width=ANCHO, height=ALTO, bg=FONDO, highlightthickness=0)
        lienzo.pack()
        for _ in range(110):
            x, y = random.randint(0, ANCHO), random.randint(0, ALTO)
            tamano = random.choice([1, 1, 2, 3])
            lienzo.create_rectangle(x, y, x + tamano, y + tamano,
                                    fill=random.choice(["#2a3352", "#56658f", "#b9c6ff"]), outline="")
        lienzo.create_text(ANCHO // 2 + 3, 203, text="SECTOR ZERO", fill=MAGENTA,
                           font=("Consolas", 52, "bold"))
        lienzo.create_text(ANCHO // 2, 200, text="SECTOR ZERO", fill=CIAN,
                           font=("Consolas", 52, "bold"))
        lienzo.create_text(ANCHO // 2, 260, text="POO II · UNITRÓPICO", fill=GRIS,
                           font=("Consolas", 12))
        for i, (texto, accion) in enumerate((("JUGAR", self.jugar),
                                             ("PUNTAJES", self.ver_puntajes),
                                             ("SALIR", self.salir))):
            boton = ttk.Button(lienzo, text=texto, command=accion, width=18)
            lienzo.create_window(ANCHO // 2, 380 + i * 64, window=boton)
        lienzo.create_text(ANCHO // 2, ALTO - 40,
                           text="← → o A D para mover · ESPACIO dispara · ESC pausa",
                           fill=GRIS, font=("Consolas", 10))

    def jugar(self):
        DialogoNombre(self, al_aceptar=self.iniciar_partida)   # ida: padre y callback

    def iniciar_partida(self, nombre):      # el callback que recibe el nombre
        self.ultimo_piloto = nombre
        self.limpiar()
        PantallaJuego(self, nombre, al_terminar=self.fin_partida).pack()

    def fin_partida(self, nombre, puntaje): # el callback que recibe el puntaje
        self.puntajes.append((nombre, puntaje))
        self.puntajes.sort(key=lambda p: p[1], reverse=True)
        self.puntajes = self.puntajes[:5]
        DialogoFinal(self, nombre, puntaje, self.puntajes, al_elegir=self.despues_del_final)

    def despues_del_final(self, opcion):
        if opcion == "otra":
            self.iniciar_partida(self.ultimo_piloto)
        else:
            self.mostrar_menu()

    def ver_puntajes(self):
        DialogoPuntajes(self, self.puntajes)

    def salir(self):
        if messagebox.askyesno("Salir", "¿Desea salir de SECTOR ZERO?"):
            self.destroy()

# logica.py  -  Responsable: Santiago
# La lógica del juego. Este archivo NO importa tkinter: solo calcula.
# La pantalla le pregunta qué dibujar; la lógica decide qué pasa.
import random
from abc import ABC, abstractmethod

ANCHO = 600
ALTO = 720


class Entidad(ABC):
    # ABSTRACCIÓN: el molde de todo lo que existe en el juego.
    # Nadie puede crear una "Entidad" suelta: solo sus hijas.
    def __init__(self, x, y, ancho, alto, **kwargs):
        super().__init__(**kwargs)          # cooperativo: sigue la fila del MRO
        self.x = x                          # (x, y) es el centro del objeto
        self.y = y
        self.ancho = ancho
        self.alto = alto
        self.activa = True

    @abstractmethod
    def actualizar(self):                   # contrato: toda hija debe moverse a su manera
        pass

    def choca_con(self, otra):
        return (abs(self.x - otra.x) * 2 < self.ancho + otra.ancho and
                abs(self.y - otra.y) * 2 < self.alto + otra.alto)


class Bala(Entidad):
    def __init__(self, velocidad, enemiga=False, **kwargs):
        super().__init__(ancho=4, alto=14, **kwargs)
        self.velocidad = velocidad          # negativa sube, positiva baja
        self.enemiga = enemiga

    def actualizar(self):
        self.y += self.velocidad
        if self.y < -20 or self.y > ALTO + 20:
            self.activa = False


class Nave(Entidad):
    VIDA_MAXIMA = 3
    VELOCIDAD = 7
    ESPERA_DISPARO = 9                      # cuadros entre un disparo y otro
    TIEMPO_INVULNERABLE = 70                # cuadros sin recibir daño tras un golpe

    def __init__(self):
        super().__init__(x=ANCHO // 2, y=ALTO - 70, ancho=36, alto=40)
        self.__vida = Nave.VIDA_MAXIMA      # ENCAPSULAMIENTO: privado
        self.__espera = 0
        self.__invulnerable = 0
        self.direccion = 0                  # -1 izquierda, 0 quieta, 1 derecha

    @property
    def vida(self):
        return self.__vida

    @vida.setter
    def vida(self, nueva):
        if not isinstance(nueva, int):
            raise ValueError("La vida debe ser un número entero")
        self.__vida = max(0, min(nueva, Nave.VIDA_MAXIMA))

    @property
    def invulnerable(self):                 # propiedad de solo lectura
        return self.__invulnerable > 0

    def actualizar(self):
        self.x += self.direccion * Nave.VELOCIDAD
        self.x = max(self.ancho // 2, min(self.x, ANCHO - self.ancho // 2))
        if self.__espera > 0:
            self.__espera -= 1
        if self.__invulnerable > 0:
            self.__invulnerable -= 1

    def disparar(self):
        if self.__espera > 0:
            return None
        self.__espera = Nave.ESPERA_DISPARO
        return Bala(x=self.x, y=self.y - self.alto // 2, velocidad=-12)

    def recibir_dano(self):
        if self.invulnerable:
            return False
        self.vida = self.vida - 1           # pasa por el setter, que valida
        self.__invulnerable = Nave.TIEMPO_INVULNERABLE
        return True


class Enemigo(Entidad):
    TIPO = "basico"
    PUNTOS = 100

    def __init__(self, velocidad, **kwargs):
        super().__init__(**kwargs)
        self.velocidad = velocidad

    def actualizar(self):
        self.y += self.velocidad
        if self.y > ALTO + 40:
            self.activa = False

    def recibir_dano(self):                 # un solo golpe lo destruye
        self.activa = False


class EnemigoZigzag(Enemigo):
    TIPO = "zigzag"
    PUNTOS = 150

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.paso = 0

    def actualizar(self):                   # SOBRESCRITURA
        super().actualizar()                # baja como cualquier enemigo...
        self.paso += 1                      # ...y además se mueve de lado
        self.x += 3 if (self.paso // 30) % 2 == 0 else -3
        self.x = max(20, min(self.x, ANCHO - 20))


class Disparador(Entidad):
    # La capacidad de disparar hacia abajo.
    # Hereda de Entidad igual que Enemigo: por eso Jefe forma un DIAMANTE.
    def __init__(self, cadencia, **kwargs):
        super().__init__(**kwargs)
        self.cadencia = cadencia
        self.contador = 0

    def intentar_disparar(self):
        self.contador += 1
        if self.contador >= self.cadencia:
            self.contador = 0
            return Bala(x=self.x, y=self.y + self.alto // 2, velocidad=7, enemiga=True)
        return None


class Jefe(Enemigo, Disparador):
    # HERENCIA MÚLTIPLE: es enemigo y además dispara.
    # MRO: Jefe -> Enemigo -> Disparador -> Entidad
    # Gracias a super() y **kwargs, Entidad se inicializa UNA sola vez.
    TIPO = "jefe"
    PUNTOS = 1000
    VIDA_MAXIMA = 20

    def __init__(self):
        super().__init__(x=ANCHO // 2, y=-60, ancho=120, alto=64,
                         velocidad=2, cadencia=40)
        self.__vida = Jefe.VIDA_MAXIMA

    @property
    def vida(self):
        return self.__vida

    def actualizar(self):                   # entra desde arriba y luego va de lado a lado
        if self.y < 110:
            self.y += abs(self.velocidad)
        else:
            self.x += self.velocidad
            if self.x < 80 or self.x > ANCHO - 80:
                self.velocidad = -self.velocidad

    def recibir_dano(self):                 # SOBRESCRITURA: aguanta varios golpes
        self.__vida -= 1
        if self.__vida <= 0:
            self.activa = False


class Juego:
    # Coordina la partida: crea enemigos, revisa choques y lleva el puntaje.
    def __init__(self):
        self.nave = Nave()
        self.balas = []
        self.enemigos = []
        self.eventos = []                   # avisos para la pantalla (explosiones)
        self.terminado = False
        self.__puntaje = 0
        self.__cuadro = 0
        self.__proximo_jefe = 2500

    @property
    def puntaje(self):                      # solo lectura: nadie lo cambia desde afuera
        return self.__puntaje

    @property
    def nivel(self):                        # propiedad calculada
        return 1 + self.__puntaje // 1500

    def avanzar(self, izquierda, derecha, disparando):
        # Un "cuadro" del juego. La pantalla lo llama unas 60 veces por segundo.
        self.eventos.clear()
        if self.terminado:
            return
        self.__cuadro += 1
        self.nave.direccion = int(derecha) - int(izquierda)
        if disparando:
            bala = self.nave.disparar()
            if bala:
                self.balas.append(bala)
        self.__crear_enemigos()

        for entidad in [self.nave] + self.balas + self.enemigos:
            entidad.actualizar()            # POLIMORFISMO: cada uno se mueve a su manera

        for enemigo in self.enemigos:
            if isinstance(enemigo, Disparador):
                bala = enemigo.intentar_disparar()
                if bala:
                    self.balas.append(bala)

        self.__revisar_choques()
        self.balas = [b for b in self.balas if b.activa]
        self.enemigos = [e for e in self.enemigos if e.activa]

    def __crear_enemigos(self):
        hay_jefe = any(isinstance(e, Jefe) for e in self.enemigos)
        if self.__puntaje >= self.__proximo_jefe and not hay_jefe:
            self.enemigos.append(Jefe())
            self.eventos.append(("jefe", ANCHO // 2, 0, "jefe"))
            self.__proximo_jefe += 4000
            return
        intervalo = 90 if hay_jefe else max(18, 55 - self.nivel * 6)
        if self.__cuadro % intervalo != 0:
            return
        x = random.randint(30, ANCHO - 30)
        velocidad = random.uniform(2, 3) + self.nivel * 0.4
        if random.random() < 0.3:
            self.enemigos.append(EnemigoZigzag(x=x, y=-30, ancho=34, alto=30, velocidad=velocidad))
        else:
            self.enemigos.append(Enemigo(x=x, y=-30, ancho=34, alto=30, velocidad=velocidad))

    def __revisar_choques(self):
        for bala in self.balas:
            if not bala.activa:
                continue
            if bala.enemiga:
                if bala.choca_con(self.nave):
                    bala.activa = False
                    self.__danar_nave()
                continue
            for enemigo in self.enemigos:
                if enemigo.activa and bala.choca_con(enemigo):
                    bala.activa = False
                    enemigo.recibir_dano()  # POLIMORFISMO: básico muere, jefe aguanta
                    if enemigo.activa:
                        self.eventos.append(("impacto", bala.x, bala.y, enemigo.TIPO))
                    else:
                        self.__puntaje += enemigo.PUNTOS
                        self.eventos.append(("explosion", enemigo.x, enemigo.y, enemigo.TIPO))
                    break

        for enemigo in self.enemigos:
            if enemigo.activa and enemigo.choca_con(self.nave):
                if not isinstance(enemigo, Jefe):
                    enemigo.activa = False
                    self.eventos.append(("explosion", enemigo.x, enemigo.y, enemigo.TIPO))
                self.__danar_nave()

    def __danar_nave(self):
        if self.nave.recibir_dano():
            self.eventos.append(("golpe", self.nave.x, self.nave.y, "nave"))
            if self.nave.vida == 0:
                self.terminado = True
                self.eventos.append(("explosion", self.nave.x, self.nave.y, "nave"))

